pipeline {
    agent any

    tools {
        jdk 'JAVA_HOME'
        maven 'M2_HOME'
    }

    environment {
        DOCKERHUB_USER = 'nidhaltaboui'
        IMAGE_NAME = "${DOCKERHUB_USER}/backend-app"
    }

    stages {
        stage('Checkout') {
            steps {
                echo 'Récupération du code source...'
                checkout scm
            }
        }

        stage('Build') {
            steps {
                echo 'Compilation du projet backend...'
                dir('backend') {
                    sh 'mvn clean compile'
                }
            }
        }

        stage('Test') {
            steps {
                echo 'Exécution des tests unitaires...'
                dir('backend') {
                    sh 'mvn test'
                }
            }
        }

        stage('Package') {
            steps {
                echo 'Génération du livrable (.jar)...'
                dir('backend') {
                    sh 'mvn package -DskipTests'
                }
            }
        }

        stage('Archive') {
            steps {
                archiveArtifacts artifacts: 'backend/target/*.jar', fingerprint: true
            }
        }

        stage('Docker Build') {
            steps {
                echo 'Construction de l\'image Docker backend-app...'
                dir('backend') {
                    sh 'docker build -t backend-app:latest .'
                    sh "docker tag backend-app:latest ${IMAGE_NAME}:latest"
                }
            }
        }

        stage('Docker Push') {
            steps {
                echo 'Publication de l\'image sur Docker Hub...'
                withCredentials([usernamePassword(credentialsId: 'dockerhub-credentials', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
                    sh '''
                        echo "$DOCKER_PASS" | docker login -u "$DOCKER_USER" --password-stdin
                        docker push ${IMAGE_NAME}:latest
                        docker logout
                    '''
                }
            }
        }

                stage('Deploy MySQL') {
            steps {
                echo 'Démarrage du conteneur MySQL...'
                sh '''
                    docker rm -f mysql || true
                    docker run -d \
                        --name mysql \
                        --network backend-net \
                        -e MYSQL_ROOT_PASSWORD=root \
                        -e MYSQL_DATABASE=test_db \
                        -e MYSQL_USER=devops \
                        -e MYSQL_PASSWORD=devops123 \
                        -p 3307:3306 \
                        -v mysql-data:/var/lib/mysql \
                        mysql:8.0
                    echo "Attente du démarrage de MySQL..."
                    sleep 20
                '''
            }
        }

                stage('Deploy Backend') {
            steps {
                echo 'Déploiement du nouveau conteneur backend-app...'
                withCredentials([usernamePassword(credentialsId: 'dockerhub-credentials', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
                    sh '''
                        echo "$DOCKER_PASS" | docker login -u "$DOCKER_USER" --password-stdin
                        docker stop backend-app || true
                        docker rm backend-app || true
                        docker pull ${IMAGE_NAME}:latest
                        docker run -d \
                            --name backend-app \
                            --network backend-net \
                            -p 8082:8080 \
                            -e SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/test_db \
                            -e SPRING_DATASOURCE_USERNAME=devops \
                            -e SPRING_DATASOURCE_PASSWORD=devops123 \
                            ${IMAGE_NAME}:latest
                        docker logout
                    '''
                }
            }
        }

        stage('Verify Deployment') {
            steps {
                echo 'Vérification des conteneurs actifs...'
                sh 'docker ps'
                echo 'Attente du démarrage du backend...'
                sh 'sleep 15'
                echo 'Logs du conteneur backend-app :'
                sh 'docker logs backend-app'
            }
        }
    }

    post {
        success {
            echo '✅ Pipeline exécuté avec succès !'
        }
        failure {
            echo '❌ Le pipeline a échoué. Consultez la Console Output.'
        }
        always {
            junit allowEmptyResults: true, testResults: 'backend/target/surefire-reports/*.xml'
        }
    }
}
